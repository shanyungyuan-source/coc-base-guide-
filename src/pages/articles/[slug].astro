---
import { getCollection } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.slug },
    props: { article, allArticles: articles },
  }));
}

const { article, allArticles } = Astro.props;
const { Content, headings } = await article.render();

// Related articles: same tags, exclude self, max 3
const related = allArticles
  .filter(a => a.slug !== article.slug)
  .map(a => ({
    article: a,
    score: (a.data.tags ?? []).filter(t => (article.data.tags ?? []).includes(t)).length,
  }))
  .filter(x => x.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(x => x.article);

// Estimate reading time
const wordCount = article.body.split(/\s+/).length;
const readingTime = Math.max(1, Math.round(wordCount / 220));

// TOC: only H2s (depth 2)
const tocHeadings = headings.filter(h => h.depth === 2);
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  date={article.data.date}
  tags={article.data.tags}
  image={article.data.image}
  slug={article.slug}
  readingTime={readingTime}
  tocHeadings={tocHeadings}
  related={related}
>
  <Content />
</ArticleLayout>
