---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allArticles = (await getCollection('articles')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const siteName = 'COC Base Guide';
const siteDesc = 'Expert Clash of Clans base layouts and attack strategies for every Town Hall level. Trophy bases, war bases, farming bases, and more.';

// Card cover theme + icon based on article tags/title
function getCardTheme(tags: string[], title: string): { theme: string; icon: string } {
  const t = [...tags.map(s => s.toLowerCase()), title.toLowerCase()].join(' ');
  if (/attack|3-star|laloon|hydra|hog rider|electro dragon|super witch|root rider|yeti|queen walk|blimp/.test(t))
    return { theme: 'theme-attack', icon: '⚔️' };
  if (/war base|clan castle|defense|base design|anti/.test(t))
    return { theme: 'theme-defense', icon: '🛡️' };
  if (/hero|equipment|tier list|barbarian king|archer queen|warden|royal champion|druid/.test(t))
    return { theme: 'theme-hero', icon: '👑' };
  if (/clan capital|cwl|clan war league|clan|find/.test(t))
    return { theme: 'theme-clan', icon: '🏆' };
  if (/upgrade|magic item|book|potion|wall|builder base|bh|farming|trophy push|beginner|legend league/.test(t))
    return { theme: 'theme-tips', icon: '📈' };
  // TH level guides
  return { theme: 'theme-th', icon: '🏰' };
}

// Group articles into categories
function categorize(articles: typeof allArticles) {
  const thBase = articles.filter(a => /th\d+-base-2026/.test(a.slug));
  const thAttack = articles.filter(a => /attack/.test(a.slug));
  const thUpgrade = articles.filter(a => /upgrade-priority/.test(a.slug));
  const heroEquip = articles.filter(a => /hero|equipment/.test(a.slug) && !a.slug.includes('attack'));
  const strategies = articles.filter(a =>
    /super-troop|siege|hog-rider|electro-dragon|beginner-attack|best-coc-attack|how-to-3-star/.test(a.slug));
  const progressTips = articles.filter(a =>
    /magic-item|farming|wall-upgrade|trophy-push|builder-base|legend-league/.test(a.slug));
  const clanWar = articles.filter(a =>
    /clan-capital|cwl|war-base-design|clan-castle|how-to-find-best-clan/.test(a.slug));
  const beginner = articles.filter(a => /beginner-complete/.test(a.slug));

  // Catch-all for uncategorized
  const categorized = new Set([
    ...thBase, ...thAttack, ...thUpgrade, ...heroEquip,
    ...strategies, ...progressTips, ...clanWar, ...beginner
  ].map(a => a.slug));
  const other = articles.filter(a => !categorized.has(a.slug));

  return { thBase, thAttack, thUpgrade, heroEquip, strategies, progressTips, clanWar, beginner, other };
}

const cats = categorize(allArticles);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
